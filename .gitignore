# Swift Package Manager 빌드 산출물 — 400MB가 넘고, build.sh 돌리면 다시 만들어짐
.build/
.swiftpm/

# 빌드된 앱 번들 — 소스가 아니라 결과물. 배포는 Releases에 올리는 방식으로 한다
*.app/
dist/

# macOS 잡파일
.DS_Store

# 아이콘을 만들 때 쓴 AI 프롬프트 메모 — 재작업용으로 로컬에만 둔다 (2026-09-22)
assets/icon/AI-프롬프트.md

# DMG 설치 창을 만드는 도구용 가상환경 — 각자 로컬에 만든다 (2026-09-22)
# 설치: python3 -m venv .tools/venv && .tools/venv/bin/python -m pip install dmgbuild
.tools/

# 세션 인계 문서 — 로컬 작업 메모다 (2026-09-22)
HANDOFF_*.md

# 배포 기록(dSYM·공증 로그·체크섬) — 로컬 보관용이고 저장소에 올리지 않는다 (2026-09-22)
release-records/

# 서명 재료 — 인증서·개인키·프로비저닝 파일 (2026-09-23, #5)
# 🔒 공개 저장소다. 인증서 백업(.p12)을 저장하다가 이 폴더를 고르고 `git add -A` 하면 개인키가
#    그대로 공개되고, 한 번 푸시하면 기록에서 지우기 어렵다. "넣지 말 것"이라는 주의를 규칙으로 바꾼다.
#    (*.key 는 Keynote 파일과 확장자가 같다 — 이 저장소에 Keynote 를 둘 일은 없다고 보고 함께 막는다)
*.p12
*.pfx
*.cer
*.certSigningRequest
*.key
*.pem
*.p8
*.keychain
*.keychain-db
*.provisionprofile
